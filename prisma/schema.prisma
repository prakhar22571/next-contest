generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  credential     GoogleCredential?
  preference     UserPreference?
  syncedContests SyncedContest[]
  syncRuns       SyncRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Encrypted, cron-accessible copy of Google OAuth tokens (independent of
// Account.refresh_token so background syncs work without an active session).
model GoogleCredential {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  encryptedRefreshToken  String    @db.Text
  encryptedAccessToken   String?   @db.Text
  accessTokenExpiresAt   DateTime?
  scope                  String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Seeded catalog of supported platforms. Slugs use the "codeforces.com" style.
model Platform {
  id       Int     @id @default(autoincrement())
  slug     String  @unique
  name     String
  isActive Boolean @default(true)
}

model UserPreference {
  id           String    @id @default(cuid())
  userId       String    @unique
  platforms    String[]
  daysAhead    Int       @default(14)
  timeZone     String    @default("UTC")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SyncContestStatus {
  SUCCESS
  FAILED
}

// One row per (user, contest) - prevents duplicate calendar events across repeated syncs.
model SyncedContest {
  id              String            @id @default(cuid())
  userId          String
  contestId       String
  platform        String
  title           String
  startTime       DateTime
  endTime         DateTime
  contestUrl      String?
  calendarEventId String?
  status          SyncContestStatus
  errorMessage    String?
  syncedAt        DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([userId, status])
}

enum SyncTrigger {
  MANUAL
  CRON
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

// One row per sync execution - powers the dashboard "last synced" / status UI.
model SyncRun {
  id              String        @id @default(cuid())
  userId          String
  trigger         SyncTrigger
  status          SyncRunStatus @default(RUNNING)
  contestsFound   Int           @default(0)
  contestsCreated Int           @default(0)
  contestsFailed  Int           @default(0)
  errorMessage    String?
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}
